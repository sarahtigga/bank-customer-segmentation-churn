        "# =========================\n",
        "# CUSTOMER SEGMENTATION & CHURN PATTERN ANALYTICS\n",
        "# EUROPEAN BANKING\n",
        "# =========================\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# -------------------------\n",
        "# LOAD DATASET\n",
        "# -------------------------\n",
        "df = pd.read_csv(\"European_Bank.csv.csv\")  # change if needed\n",
        "\n",
        "# -------------------------\n",
        "# BASIC CLEANING\n",
        "# -------------------------\n",
        "df = df.drop(columns=[col for col in ['CustomerId', 'Surname'] if col in df.columns])\n",
        "\n",
        "print(\"Dataset Shape:\", df.shape)\n",
        "print(df.head())\n",
        "\n",
        "# -------------------------\n",
        "# CHURN RATE\n",
        "# -------------------------\n",
        "churn_rate = df['Exited'].mean() * 100\n",
        "print(\"\\nOverall Churn Rate:\", round(churn_rate, 2), \"%\")\n",
        "\n",
        "# -------------------------\n",
        "# GEOGRAPHY ANALYSIS\n",
        "# -------------------------\n",
        "geo_churn = df.groupby('Geography')['Exited'].mean() * 100\n",
        "print(\"\\nChurn by Geography:\\n\", geo_churn)\n",
        "\n",
        "# -------------------------\n",
        "# AGE GROUP SEGMENTATION\n",
        "# -------------------------\n",
        "df['AgeGroup'] = pd.cut(df['Age'], bins=[0,30,45,60,100],\n",
        "                        labels=['<30','30-45','46-60','60+'])\n",
        "\n",
        "age_churn = df.groupby('AgeGroup')['Exited'].mean() * 100\n",
        "print(\"\\nChurn by Age Group:\\n\", age_churn)\n",
        "\n",
        "# -------------------------\n",
        "# ACTIVITY ANALYSIS\n",
        "# -------------------------\n",
        "activity_churn = df.groupby('IsActiveMember')['Exited'].mean() * 100\n",
        "print(\"\\nChurn by Activity:\\n\", activity_churn)\n",
        "\n",
        "# -------------------------\n",
        "# BALANCE SEGMENT\n",
        "# -------------------------\n",
        "df['BalanceSegment'] = pd.cut(df['Balance'],\n",
        "                              bins=[-1, 0, 50000, 100000, 200000],\n",
        "                              labels=['Zero','Low','Medium','High'])\n",
        "\n",
        "balance_churn = df.groupby('BalanceSegment')['Exited'].mean() * 100\n",
        "print(\"\\nChurn by Balance:\\n\", balance_churn)\n",
        "\n",
        "# -------------------------\n",
        "# VISUALS\n",
        "# -------------------------\n",
        "\n",
        "# Geography\n",
        "plt.figure(figsize=(6,4))\n",
        "geo_churn.plot(kind='bar', color='skyblue')\n",
        "plt.title(\"Churn by Geography\")\n",
        "plt.ylabel(\"Churn %\")\n",
        "plt.show()\n",
        "\n",
        "# Age Group\n",
        "plt.figure(figsize=(6,4))\n",
        "age_churn.plot(kind='bar', color='orange')\n",
        "plt.title(\"Churn by Age Group\")\n",
        "plt.ylabel(\"Churn %\")\n",
        "plt.show()\n",
        "\n",
        "# Activity\n",
        "plt.figure(figsize=(5,4))\n",
        "activity_churn.plot(kind='bar', color='green')\n",
        "plt.title(\"Churn by Activity Status\")\n",
        "plt.ylabel(\"Churn %\")\n",
        "plt.show()\n",
        "\n",
        "# Balance\n",
        "plt.figure(figsize=(6,4))\n",
        "balance_churn.plot(kind='bar', color='red')\n",
        "plt.title(\"Churn by Balance Segment\")\n",
        "plt.ylabel(\"Churn %\")\n",
        "plt.show()"
plt.figure(figsize=(10,6))
corr = df.corr(numeric_only=True)

sns.heatmap(corr, cmap='coolwarm', linewidths=0.5)
plt.title("Feature Correlation Heatmap")
plt.show()
